<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Page views",
    subtitle: "This dummy host records views into Logs. Sign in, open a page, then check Admin.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "What's wired",
          subtitle: "Collector, Viewable pages, and the Views admin section.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>The layout calls <code>recording_studio_track_views</code> so page loads post a view.</li>
          <li>Workspace pages are viewable. Folders are not.</li>
          <li>Admin under <code>/admin</code> lists stored views after you switch to Admin.</li>
        </ul>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :shaded) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Try it",
          subtitle: "Sign in, open a page, then read the Views hub.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ol class="space-y-3 text-sm leading-6 list-decimal pl-5">
          <li>Sign in, then open a page from the sidebar.</li>
          <li>Switch to Admin and open Page views.</li>
          <li>Anonymous public pages still count when Accessible allows them.</li>
        </ol>
      <% end %>
    <% end %>
  </div>
</div>
