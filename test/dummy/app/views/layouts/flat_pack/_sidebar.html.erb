<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: "Views",
      subtitle: "Recording Studio"
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 space-y-1" aria-label="Main navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Home",
        href: main_app.root_path,
        icon: :home,
        active: current_page?(main_app.root_path)
      ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Pages",
        href: main_app.pages_path,
        icon: "queue-list",
        active: request.path == main_app.pages_path
      ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "New page",
        href: main_app.new_page_path,
        icon: :plus,
        active: current_page?(main_app.new_page_path)
      ) %>
      <%= render FlatPack::Sidebar::Divider::Component.new %>
      <% dummy_sidebar_pages.each do |page| %>
        <%= render FlatPack::Sidebar::Item::Component.new(
          text: page.title.presence || "Untitled",
          href: main_app.page_path(page),
          icon: "document-text",
          active: current_page?(main_app.page_path(page))
        ) %>
      <% end %>
    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new(class: "text-sm text-[var(--surface-muted-content-color)]") do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Sign out",
        href: main_app.destroy_user_session_path,
        icon: :lock,
        class: "mx-0",
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
