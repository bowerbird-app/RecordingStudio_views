<%= render FlatPack::TopNav::Component.new do |nav| %>
  <% nav.left do %>
    <%= render FlatPack::Button::Component.new(
      icon: "menu",
      icon_only: true,
      style: :ghost,
      size: :md,
      aria: { label: "Toggle sidebar" },
      data: {
        "flat-pack--sidebar-layout-target": "mobileToggle",
        action: "click->flat-pack--sidebar-layout#toggleMobile"
      },
      class: "md:hidden"
    ) %>
  <% end %>

  <% nav.center do %>
    <div class="flex items-center gap-2">
      <% if user_signed_in? %>
        <%= recording_studio_root_switch_dropdown(style: :ghost, size: :md) %>
      <% end %>
    </div>
  <% end %>

  <% nav.right do %>
    <% if user_signed_in? %>
      <% if current_root_recording&.recordable_type == "AdminRoot" %>
        <%= render FlatPack::Button::Component.new(
          text: "Admin",
          style: :primary,
          size: :sm,
          href: "/admin",
          class: "mr-2"
        ) %>
      <% end %>

      <%= render FlatPack::Avatar::Component.new(
        name: current_user.email,
        size: :sm
      ) %>
    <% end %>
  <% end %>
<% end %>
