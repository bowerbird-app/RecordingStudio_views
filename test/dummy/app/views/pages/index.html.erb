<% dummy_page_nav(title: "Pages", back_url: root_path) %>

<%= dummy_pages_shell do %>
  <div class="flex w-full flex-col gap-6">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Pages",
      subtitle: "Open a page to count a view.",
      variant: :h1
    ) %>

    <% pages = dummy_sidebar_pages %>
    <% if pages.empty? %>
      <%= render FlatPack::EmptyState::Component.new(
        title: "Nothing here yet",
        description: "Add a page to get going."
      ) %>
    <% else %>
      <ul class="space-y-2">
        <% pages.each do |page| %>
          <li>
            <%= link_to page.title.presence || "Untitled", page_path(page), class: "text-sm font-medium text-(--surface-content-color)" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>
