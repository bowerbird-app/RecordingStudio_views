<%= render FlatPack::Sidebar::Component.new(side: :left, collapsible: false) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "P",
      title: "Pages",
      show_version: false,
      collapsible: false
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 space-y-1" aria-label="Pages">
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "All pages",
        href: pages_path,
        icon: "queue-list",
        active: request.path == pages_path
      ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "New page",
        href: new_page_path,
        icon: :plus,
        active: request.path == new_page_path
      ) %>
      <%= render FlatPack::Sidebar::Divider::Component.new %>
      <% dummy_sidebar_pages.each do |page| %>
        <%= render FlatPack::Sidebar::Item::Component.new(
          text: page.title.presence || "Untitled",
          href: page_path(page),
          icon: "document-text",
          active: current_page?(page_path(page))
        ) %>
      <% end %>
    </nav>
  <% end %>
<% end %>
