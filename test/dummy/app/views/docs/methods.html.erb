<% content_for :title, "Methods" %>
<% flat_pack_page_nav(round: true, style: :default, back_href: root_path, back_tooltip: "Home") %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Public helpers for page-view tracking in a host layout.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "recording_studio_track_views",
    subtitle: "RecordingStudioViews::TrackHelper",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # In the shared layout body, outside Turbo permanent elements.
      recording_studio_track_views
    CODE
  ) %>

  <p class="text-sm text-(--body-muted-content-color)">
    Installing the gem does not start tracking. Enable :viewable on recordable types you want counted.
  </p>
</div>
